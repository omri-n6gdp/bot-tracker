# Copy to .env and fill in. .env is git-ignored.

# Trading 212 (the key file "API Keys" is used if these two are empty)
T212_API_KEY=
T212_API_SECRET=
T212_ENV=live
# The bot pie's id: run `python -m tracker find-pie`
T212_PIE_ID=
# Each pie keeps its own history: a database file name in data/ (default tracker.db)
TRACKER_DB=
# Money paid into this pie from outside (default deposits.csv)
DEPOSITS_CSV=
# First day of history (default: the pie's creation date)
BOT_START_DATE=
BOT_START_TIME=                 # optional HH:MM (London) on that date: readings before it don't count
# Name shown to friends (defaults to the pie's name in Trading 212)
PIE_DISPLAY_NAME=
# History starts here (YYYY-MM-DD); default = the pie's creation date in Trading 212
BOT_START_DATE=

# Comparison lines (Yahoo tickers, GBP-priced). First one is the headline comparison.
BENCHMARKS=VUAG.L=S&P 500,VWRL.L=FTSE All-World

# auto = use pie endpoints, switch to backup pricing if they fail; or force pie / fallback
TRACKER_MODE=auto
TRACKER_TZ=Europe/London
DAILY_CLOSE_TIME=21:30

# Optional phone alerts (Telegram: message @BotFather to make a bot, then get your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Production: Postgres instead of SQLite (optional)
# DATABASE_URL=postgresql+psycopg://tracker:password@db:5432/tracker

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel > Docker command)
TUNNEL_TOKEN=


# Prediction game players, comma-separated (kept out of the code so names stay private)
PLAYERS=
